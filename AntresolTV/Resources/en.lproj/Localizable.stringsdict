<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>%lld movies</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@movies@</string>
        <key>movies</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld movie</string>
            <key>other</key>
            <string>%lld movies</string>
        </dict>
    </dict>
    <key>%lld shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld show</string>
            <key>other</key>
            <string>%lld shows</string>
        </dict>
    </dict>
    <key>%lld seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld season</string>
            <key>other</key>
            <string>%lld seasons</string>
        </dict>
    </dict>
    <key>%lld episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld episode</string>
            <key>other</key>
            <string>%lld episodes</string>
        </dict>
    </dict>
</dict>
</plist>
