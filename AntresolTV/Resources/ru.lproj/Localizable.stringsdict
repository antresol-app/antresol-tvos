<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>%lld movies</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@movies@</string>
        <key>movies</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld фильм</string>
            <key>few</key>
            <string>%lld фильма</string>
            <key>many</key>
            <string>%lld фильмов</string>
            <key>other</key>
            <string>%lld фильма</string>
        </dict>
    </dict>
    <key>%lld shows</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@shows@</string>
        <key>shows</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld сериал</string>
            <key>few</key>
            <string>%lld сериала</string>
            <key>many</key>
            <string>%lld сериалов</string>
            <key>other</key>
            <string>%lld сериала</string>
        </dict>
    </dict>
    <key>%lld seasons</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@seasons@</string>
        <key>seasons</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld сезон</string>
            <key>few</key>
            <string>%lld сезона</string>
            <key>many</key>
            <string>%lld сезонов</string>
            <key>other</key>
            <string>%lld сезона</string>
        </dict>
    </dict>
    <key>%lld episodes</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@episodes@</string>
        <key>episodes</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld эпизод</string>
            <key>few</key>
            <string>%lld эпизода</string>
            <key>many</key>
            <string>%lld эпизодов</string>
            <key>other</key>
            <string>%lld эпизода</string>
        </dict>
    </dict>
</dict>
</plist>
